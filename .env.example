# Copie para .env e preencha. O .env nunca deve ser commitado.

# Telegram — obtenha com o @BotFather
TELEGRAM_BOT_TOKEN=

# Todoist — Configurações > Integrações > Desenvolvedor > Token de API
TODOIST_API_TOKEN=

# DeepSeek — painel de desenvolvedor (platform.deepseek.com)
DEEPSEEK_API_KEY=

# Telegram — chat que recebe o resumo diário das 9h20 (mande /start ao bot para descobrir)
TELEGRAM_CHAT_ID=

# Fuso horário e idioma (IANA / BCP 47). Valem para o n8n (agendamentos), para as datas que o Chronos
# calcula e mostra, e para o idioma dos prazos no Todoist (pt-BR → "pt"). Padrão: São Paulo / pt-BR.
CHRONOS_TIMEZONE=America/Sao_Paulo
CHRONOS_LOCALE=pt-BR

# Agendas do Google Calendar que entram no resumo diário (/hoje) e na agenda da semana (/semana).
# Vazio = todas as agendas que você pode editar. Para restringir, liste os nomes separados por ";"
# (ex.: CHRONOS_CALENDARS="Trabalho;Pessoal"). Ao criar eventos, o Chronos escolhe entre todas as agendas editáveis.
CHRONOS_CALENDARS=

# Só para o `node scripts/setup.mjs` (não vai para o container): chave da API do n8n,
# criada em n8n > Settings > n8n API. O setup usa para criar as Data Tables que faltarem.
N8N_API_KEY=
