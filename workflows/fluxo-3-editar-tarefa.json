        "id": "d7b52677-ae09-4629-9fbe-c78507ee21b9",
        "name": "DeepSeek: calcular ajuste",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          2680,
          100
        ],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// Fuso e idioma configuráveis no .env; o Todoist recebe só o idioma (pt-BR → pt)\nconst ZONE = $env.CHRONOS_TIMEZONE || 'America/Sao_Paulo';\nconst LOCALE = $env.CHRONOS_LOCALE || 'pt-BR';\nconst DUE_LANG = LOCALE.split('-')[0];\nconst ctx = $('Montar prompt de edição').first().json;\nconst task = ctx.task;\nconst projects = ctx.projects || [];\nconst base = { chat_id: ctx.chat_id, task_id: task.id, title: task.content };\nconst fmtDue = (due) => {\n  if (!due || !due.date) return 'sem prazo';\n  const d = String(due.date);\n  const dt = DateTime.fromISO(d, { zone: ZONE }).setLocale(LOCALE);\n  if (!dt.isValid) return d;\n  return d.includes('T') ? dt.toFormat(\"ccc dd/MM 'às' HH:mm\") : dt.toFormat('ccc dd/MM');\n};\n\nif ($json.error) {\n  return [{ json: { ...base, ok: false, has_changes: false, motivo: 'DeepSeek indisponível: ' + String($json.error.message || '').slice(0, 200) } }];\n}\nlet parsed = null;\ntry { parsed = JSON.parse($json.choices[0].message.content || ''); } catch (e) { parsed = null; }\nif (!parsed || typeof parsed !== 'object') {\n  return [{ json: { ...base, ok: false, has_changes: false, motivo: 'DeepSeek não retornou JSON válido' } }];\n}\nconst ch = parsed.changes && typeof parsed.changes === 'object' ? parsed.changes : {};\nconst summary = String(parsed.summary || '').trim();\nconst label = { 1: '🔴 urgente', 2: '🟠 alta', 3: '🔵 média', 4: '⚪ normal' };\nconst has = (k) => Object.prototype.hasOwnProperty.call(ch, k) && ch[k] !== null && ch[k] !== undefined;\n\nconst update = {};\nconst move = {};\nconst lines = [];\nconst avisos = [];\nlet due_changed = false;\n\nif (has('content') && String(ch.content).trim() && String(ch.content).trim() !== task.content) {\n  update.content = String(ch.content).trim();\n  lines.push('📝 Título: ' + esc(task.content) + ' → <b>' + esc(update.content) + '</b>');\n}\nif (has('description') && String(ch.description).trim() !== String(task.description || '').trim()) {\n  update.description = String(ch.description).trim();\n  lines.push(update.description ? '🗒 Descrição atualizada' : '🗒 Descrição removida');\n}\nif (has('due') && String(ch.due).trim()) {\n  const d = String(ch.due).trim();\n  if (/^(sem prazo|sem data|no date|remover( o)? prazo|nenhum)$/i.test(d)) update.due_string = 'no date';\n  else { update.due_string = d; update.due_lang = DUE_LANG; }\n  due_changed = true;\n}\nif (has('priority')) {\n  const p = parseInt(ch.priority, 10);\n  if (p >= 1 && p <= 4 && 5 - p !== task.priority) {\n    update.priority = 5 - p;\n    lines.push('⚑ Prioridade: ' + label[5 - (task.priority || 1)] + ' → <b>' + label[p] + '</b>');\n  }\n}\n\n// projeto / seção → endpoint de move (aceita um destino por vez)\nconst nrm = (s) => String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();\nconst current = projects.find(p => p.id === task.project_id) || null;\nlet target = current;\nif (has('project') && String(ch.project).trim()) {\n  const want = nrm(ch.project);\n  const alias = ['entrada', 'inbox', 'caixa de entrada'].includes(want);\n  const found = alias ? projects.find(p => p.inbox) : projects.find(p => nrm(p.name) === want);\n  if (!found) avisos.push('projeto \"' + esc(ch.project) + '\" não existe — mantido em ' + esc(current ? current.name : '?'));\n  else if (found.id !== task.project_id) {\n    target = found;\n    move.project_id = found.id;\n    lines.push('📁 Projeto: ' + esc(current ? current.name : '?') + ' → <b>' + esc(found.name) + '</b>');\n  }\n}\nif (has('section') && target) {\n  const want = nrm(ch.section);\n  if (!want) {\n    if (task.section_id && !move.project_id) { move.project_id = target.id; lines.push('📂 Seção removida'); }\n  } else {\n    const sec = (target.sections || []).find(s => nrm(s.name) === want);\n    if (!sec) avisos.push('seção \"' + esc(ch.section) + '\" não existe em ' + esc(target.name));\n    else if (sec.id !== task.section_id) {\n      delete move.project_id;\n      move.section_id = sec.id;\n      lines.push('📂 Seção: <b>' + esc(sec.name) + '</b>');\n    }\n  }\n}\n\nconst has_update = Object.keys(update).length > 0;\nconst has_move = Object.keys(move).length > 0;\nreturn [{ json: {\n  ...base, ok: true, has_changes: has_update || has_move, has_update, has_move,\n  update_body: update, move_body: move, lines, avisos, summary, due_changed, old_due: fmtDue(task.due),\n  motivo: summary || 'o pedido não altera nenhum campo',\n} }];\n"
        },
