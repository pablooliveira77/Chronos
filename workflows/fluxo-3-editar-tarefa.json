          "jsCode": "const squash = (v) => String(v || '').replace(/\\s+/g, ' ').trim();\nconst alvo = $('Alvo da edição').first().json;\nconst task = $('Obter tarefa').first().json;\nconst rawSections = ($input.first().json.results || []).filter(s => !s.is_archived && !s.is_deleted);\nconst projects = ($('Buscar projetos').first().json.results || [])\n  .filter(p => !p.is_archived && !p.is_deleted)\n  .map(p => ({\n    id: p.id,\n    name: p.inbox_project ? 'Entrada' : p.name,\n    description: squash(p.description),\n    inbox: !!p.inbox_project,\n    sections: rawSections.filter(s => s.project_id === p.id).map(s => ({ id: s.id, name: s.name })),\n  }));\nconst catalog = projects.map(p => '- \"' + p.name + '\"' + (p.description ? ': ' + p.description : '') + (p.sections.length ? ' | seções: ' + p.sections.map(s => '\"' + s.name + '\"').join(', ') : '')).join('\\n');\nconst proj = projects.find(p => p.id === task.project_id) || null;\nconst sec = proj ? proj.sections.find(s => s.id === task.section_id) || null : null;\nconst current = {\n  titulo: task.content,\n  descricao: task.description || '',\n  prazo: task.due ? (task.due.string || task.due.date) : null,\n  prazo_data: task.due ? task.due.date : null,\n  prioridade: 5 - (task.priority || 1),\n  projeto: proj ? proj.name : '?',\n  secao: sec ? sec.name : null,\n};\n// Fuso e idioma configuráveis no .env (CHRONOS_TIMEZONE / CHRONOS_LOCALE)\nconst TZ = $env.CHRONOS_TIMEZONE || 'America/Sao_Paulo';\nconst LOCALE = $env.CHRONOS_LOCALE || 'pt-BR';\nconst now = $now.setZone(TZ).setLocale(LOCALE);\n\nconst system = [\n  'Você é o Chronos. O usuário quer ALTERAR uma tarefa que já existe no Todoist. Responda SOMENTE com um objeto JSON válido, sem texto extra, neste formato:',\n  '{\"changes\": {\"content\": \"string\", \"description\": \"string\", \"due\": \"string\", \"priority\": 1 | 2 | 3 | 4, \"project\": \"string\", \"section\": \"string\"}, \"summary\": \"string\"}',\n  '',\n  'Regras:',\n  '- Em \"changes\" coloque APENAS os campos que o pedido manda mudar. Nunca repita valores atuais nem inclua campos que não foram pedidos.',\n  '- \"content\": novo título curto (até 6 palavras, no imperativo).',\n  '- \"description\": a descrição COMPLETA nova. Se o pedido for acrescentar algo, junte ao texto atual; se for trocar, substitua; \"\" para apagar a descrição.',\n  '- \"due\": novo prazo em linguagem natural em português, como o usuário diria (\"sexta\", \"amanhã às 15h\", \"dia 20\", \"toda segunda\"). Para remover o prazo, use exatamente \"sem prazo\".',\n  '- \"priority\": 1 = urgente, 2 = alta, 3 = média, 4 = normal.',\n  '- \"project\": EXATAMENTE um nome do catálogo abaixo (\"Entrada\" para a caixa de entrada). \"section\": nome EXATO de uma seção desse projeto, ou \"\" para tirar da seção.',\n  '- \"summary\": frase curta em português descrevendo a mudança (ex.: \"prazo movido para sexta\").',\n  '- Se o pedido não for uma alteração possível desses campos (ex.: apagar ou concluir a tarefa), devolva {\"changes\": {}, \"summary\": \"<motivo curto>\"}.',\n  '',\n  'Catálogo de projetos do Todoist:',\n  catalog,\n  '',\n  'Data e hora atual: ' + now.toFormat(\"cccc, dd/MM/yyyy HH:mm\") + ' (' + TZ + ').',\n  '',\n  'Tarefa atual: ' + JSON.stringify(current),\n  '',\n  'EXEMPLO DE PEDIDO: \"mudar prazo pra sexta e deixar urgente\"',\n  'EXEMPLO DE SAÍDA JSON: {\"changes\":{\"due\":\"sexta\",\"priority\":1},\"summary\":\"prazo movido para sexta e prioridade urgente\"}',\n].join('\\n');\n\nreturn [{ json: { system, user: alvo.adjust, chat_id: alvo.chat_id, task, projects, current } }];\n"
        },
