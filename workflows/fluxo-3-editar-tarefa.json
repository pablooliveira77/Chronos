        "id": "08ae3448-bf70-45ff-9893-1d525d5263c7",
        "name": "Util: buscar tarefa",
        "type": "n8n-nodes-base.executeWorkflow",
        "typeVersion": 1.3,
        "position": [
          680,
          300
        ],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst cut = (s, n) => { s = String(s || ''); return s.length > n ? s.slice(0, n - 1) + '…' : s; };\nconst c = $('Interpretar comando').first().json;\nconst r = $input.first().json || {};\n\nif (r.status === 'one' && r.best) {\n  return [{ json: { decisao: 'editar', chat_id: c.chat_id, edit_task_id: r.best.id, adjust: c.adjust } }];\n}\nif (r.status === 'many' && (r.candidates || []).length) {\n  const pid = Math.random().toString(36).slice(2, 10);\n  const cands = r.candidates.slice(0, 5);\n  const lines = ['🔎 Achei ' + (cands.length === 1 ? 'uma tarefa parecida' : cands.length + ' tarefas parecidas') + ' com <b>“' + esc(c.name) + '”</b>. Qual delas devo editar?', ''];\n  cands.forEach((t, i) => lines.push((i + 1) + '. ' + esc(t.content) + ' <i>#' + esc(t.project) + (t.parent_content ? ' ↳ ' + esc(t.parent_content) : '') + '</i>'));\n  lines.push('', '✏️ <i>' + esc(c.adjust) + '</i>');\n  const keyboard = cands.map((t, i) => [{ text: (i + 1) + '. ' + cut(t.content, 40), callback_data: 'pk:' + pid + ':' + i }]);\n  keyboard.push([{ text: '✖️ Cancelar', callback_data: 'pk:' + pid + ':x' }]);\n  const payload = { adjust: c.adjust, name: c.name, candidates: cands.map(t => ({ id: t.id, content: t.content, project: t.project })) };\n  return [{ json: {\n    decisao: 'perguntar', pid, chat_id: c.chat_id, payload: JSON.stringify(payload),\n    tg: { chat_id: c.chat_id, text: lines.join('\\n'), parse_mode: 'HTML', reply_markup: { inline_keyboard: keyboard } },\n  } }];\n}\nconst why = r.status ? '' : '\\n<i>(falha ao consultar o Todoist)</i>';\nreturn [{ json: { decisao: 'nenhuma', chat_id: c.chat_id, tg: { chat_id: c.chat_id, parse_mode: 'HTML',\n  text: '🔎 Não encontrei nenhuma tarefa aberta chamada <b>“' + esc(c.name) + '”</b>. Nada foi alterado.' + why + '\\n\\nConfira o nome e tente de novo: <code>/edit &lt;nome&gt; | &lt;ajuste&gt;</code>' } } }];\n"
        },
