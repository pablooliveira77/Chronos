      {
        "parameters": {
          "jsCode": "const u = $input.first().json;\nif (u.edit_task_id && u.adjust) {\n  return [{ json: { modo: 'direto', chat_id: u.chat_id, edit_task_id: u.edit_task_id, adjust: String(u.adjust) } }];\n}\nconst args = String(u.args || '').trim();\nconst i = args.indexOf('|');\nconst name = i >= 0 ? args.slice(0, i).trim() : '';\nconst adjust = i >= 0 ? args.slice(i + 1).trim() : '';\nif (!name || !adjust) return [{ json: { modo: 'uso', chat_id: u.chat_id, args } }];\nreturn [{ json: { modo: 'buscar', chat_id: u.chat_id, name, adjust } }];\n"
        },
