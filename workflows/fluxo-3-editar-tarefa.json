          "jsCode": "const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst ZONE = $env.CHRONOS_TIMEZONE || 'America/Sao_Paulo';\nconst LOCALE = $env.CHRONOS_LOCALE || 'pt-BR';\nconst a = $('Interpretar ajuste').first().json;\nlet upd = null;\ntry { upd = $('Todoist: atualizar').first().json; } catch (e) { upd = null; }\nconst fmtDue = (due) => {\n  if (!due || !due.date) return 'sem prazo';\n  const d = String(due.date);\n  const dt = DateTime.fromISO(d, { zone: ZONE }).setLocale(LOCALE);\n  if (!dt.isValid) return d;\n  return d.includes('T') ? dt.toFormat(\"ccc dd/MM 'às' HH:mm\") : dt.toFormat('ccc dd/MM');\n};\nconst lines = [...a.lines];\nif (a.due_changed) lines.push('📅 Prazo: ' + esc(a.old_due) + ' → <b>' + esc(upd && upd.id ? fmtDue(upd.due) : '?') + '</b>');\nconst title = (upd && upd.content) || a.title;\nconst text = [\n  '✅ <b>' + esc(title) + '</b> atualizada' + (a.summary ? ' — ' + esc(a.summary) : ''),\n  '',\n  ...lines.map(l => '• ' + l),\n  (a.avisos || []).length ? '\\n<i>' + a.avisos.join('; ') + '</i>' : null,\n].filter(l => l !== null).join('\\n');\nreturn [{ json: { tg: { chat_id: a.chat_id, text, parse_mode: 'HTML' } } }];\n"
