        "parameters": {
          "jsCode": "const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst row = $input.first().json;\nlet payload = {};\ntry { payload = JSON.parse(row.payload || '{}'); } catch (e) { payload = {}; }\nconst where = esc(payload.project_name || 'Entrada') + (payload.section_name ? ' › ' + esc(payload.section_name) : '');\nreturn [{ json: {\n  pid: row.pid,\n  chat_id: row.chat_id,\n  message_id: row.message_id || null,\n  task_body: payload.task_body || { content: payload.title || 'Tarefa sem título' },\n  subtarefas: payload.subtarefas || [],\n  aviso: '⏰ Sem resposta em 30 min: criei <b>' + esc(payload.title) + '</b> sem tarefa-pai (📁 ' + where + ').'\n    + (payload.parent_query ? '\\n<i>Tarefa-pai citada: “' + esc(payload.parent_query) + '”.</i>' : ''),\n} }];\n"
