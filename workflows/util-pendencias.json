      {
        "parameters": {
          "jsCode": "const r = $('Resolver escolha').first().json;\nconst j = $input.first().json || {};\nlet extra = '';\nif (j.task_id && j.date) {\n  extra = '\\n📅 ' + j.date + (j.time ? ' ⏰ ' + j.time : '') + (j.reason ? ' <i>(' + j.reason + ')</i>' : '');\n} else if (j.due && j.due.date) {\n  const d = String(j.due.date);\n  extra = '\\n📅 ' + (d.includes('T') ? DateTime.fromISO(d, { zone: $env.CHRONOS_TIMEZONE || 'America/Sao_Paulo' }).toFormat('yyyy-MM-dd ⏰ HH:mm') : d);\n}\nlet subs = null;\ntry { subs = $('Util: criar subtarefas').first().json; } catch (e) { subs = null; }\nconst more = [subs && subs.lines ? subs.lines : '', r.nest_note || ''].filter(Boolean).join('\\n');\nreturn [{ json: { tg: { chat_id: r.chat_id, text: r.confirm_text + extra + (more ? '\\n' + more : ''), parse_mode: 'HTML' } } }];\n"
        },
