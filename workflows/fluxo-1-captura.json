      {
        "parameters": {
          "jsCode": "// Outra varredura ainda está processando (lock com menos de 3 min) → para aqui; os updates continuam pendentes no Telegram.\nconst LOCK_MS = 3 * 60 * 1000;\nconst row = $input.all().map(i => i.json).find(r => r && r.chave === 'poll_lock');\nif (row && row.valor && Date.now() - Number(row.ts || 0) < LOCK_MS) return [];\nreturn [{ json: { token: String($execution.id) } }];\n"
        },
