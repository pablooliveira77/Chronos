      {
        "parameters": {
          "method": "GET",
          "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getUpdates",
          "sendQuery": true,
          "specifyQuery": "keypair",
          "queryParameters": {
            "parameters": [
              {
                "name": "timeout",
                "value": "0"
              },
              {
                "name": "limit",
                "value": "50"
              },
              {
                "name": "allowed_updates",
                "value": "[\"message\",\"callback_query\"]"
              }
            ]
          },
          "options": {
            "timeout": 15000
          }
        },
        "id": "b332c02f-4ac8-4aff-ba4a-840132c90176",
        "name": "Telegram getUpdates",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          220,
          300
        ],
        "onError": "continueRegularOutput",
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 2000
      },
      {
        "parameters": {
          "jsCode": "// Normaliza cada update em um item. Sem updates (ou erro de rede no getUpdates) → nenhum item, nada roda.\nconst out = [];\nconst RESUMO = ['/hoje', '/resumo'];\nconst AJUDA = ['/start', '/id', '/ajuda', '/help'];\nconst EDIT = ['/edit', '/editar'];\nconst SEMANA = ['/semana', '/metricas', '/métricas'];\nfor (const item of $input.all()) {\n  for (const u of (item.json.result || [])) {\n    if (u.callback_query) {\n      const cq = u.callback_query;\n      const data = String(cq.data || '');\n      const sep = data.indexOf(':');\n      out.push({ json: {\n        update_id: u.update_id,\n        kind: 'callback',\n        chat_id: cq.message && cq.message.chat ? cq.message.chat.id : cq.from.id,\n        callback_id: cq.id,\n        action: sep > 0 ? data.slice(0, sep) : data,\n        task_id: sep > 0 ? data.slice(sep + 1) : '',\n        message_id: cq.message ? cq.message.message_id : null,\n        message_text: cq.message && typeof cq.message.text === 'string' ? cq.message.text : '',\n      } });\n      continue;\n    }\n    const m = u.message;\n    if (!m || typeof m.text !== 'string') {\n      out.push({ json: { update_id: u.update_id, kind: 'ignore', chat_id: m && m.chat ? m.chat.id : null } });\n      continue;\n    }\n    const text = m.text.trim();\n    let kind = 'text';\n    let command = '';\n    let args = '';\n    if (text.startsWith('/')) {\n      command = text.split(/\\s+/)[0].toLowerCase().replace(/@.*$/, '');\n      args = text.slice(text.split(/\\s+/)[0].length).trim();\n      kind = RESUMO.includes(command) ? 'cmd_resumo'\n        : EDIT.includes(command) ? 'cmd_edit'\n        : SEMANA.includes(command) ? 'cmd_semana'\n        : 'cmd_help';\n    }\n    out.push({ json: { update_id: u.update_id, kind, command, args, chat_id: m.chat.id, text, from: m.from ? (m.from.first_name || '') : '' } });\n  }\n}\nout.sort((a, b) => a.json.update_id - b.json.update_id);\nreturn out;\n"
        },
